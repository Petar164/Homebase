# Copy this file to ".env" and fill in real values there.
# ".env" is git-ignored. This example file is public, so it only holds fakes.

# Where the PostgreSQL database lives (user, password, host, database name)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/homebase"

# Signs the login cookie. Generate your own with: npx auth secret
AUTH_SECRET="replace-with-a-long-random-string"
