# This repo is PUBLIC. Everything listed here stays on my machine only.

# 1. Secrets: every .env file, except the example with fake values
.env
.env.*
!.env.example
*.pem

# 2. Real data never lives in this folder at all (see docs/PERSISTENCE.md).
#    These rules are a second line of defence in case some ends up here.
/private/
*.db
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm
*.dump
*.bak
*.csv
*.xlsx

# 3. Reference material from planning, never part of this project
/home-base/
/repos/

# 4. Generated files: rebuilt by npm, no reason to store them
node_modules/
dist/
coverage/
*.tsbuildinfo
npm-debug.log*

# 5. Machine and editor files
.DS_Store
.claude/
.vscode/
.idea/

# 6. Python (the voice worker): the environment is rebuilt by uv
.venv/
__pycache__/
*.pyc
.pytest_cache/
