{
  "name": "homebase",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/core",
    "packages/shared"
  ],
  "scripts": {
    "start": "node --env-file-if-exists=.env apps/core/src/main.ts",
    "dev": "node --env-file-if-exists=.env --watch apps/core/src/main.ts",
    "homebase": "node --env-file-if-exists=.env apps/core/src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc -p packages/shared && tsc -p apps/core"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
